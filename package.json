{
  "name": "apple-music-discord-presence",
  "version": "0.1.0",
  "description": "Mirror Apple Music's now-playing track into Discord Rich Presence on macOS",
  "type": "module",
  "bin": {
    "apple-music-discord-presence": "./dist/cli.js"
  },
  "files": ["dist", "scripts", "README.md"],
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "start": "node --experimental-strip-types src/cli.ts"
  },
  "dependencies": {
    "@xhayper/discord-rpc": "^1.1.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
